DATA_BACKEND=supabase
BOSS_RAID_ENABLED=false
# Enable only after migration 009, real asset validation and approved staging tests.
AUTH_MODE=legacy
# Change to google only after migration 008 and the Google/Supabase setup guide.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AUTH_SESSION_SECRET=
# Required in production: generate at least 32 random characters.
SUPER_ADMIN_EMAIL=piyawatpiwsiri@gmail.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production uses the exact HTTPS app origin. Set NEXT_PUBLIC_* before building.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY= (alternative to ANON_KEY)
# Google Client ID/Secret belong in Supabase Provider settings, not client code.
